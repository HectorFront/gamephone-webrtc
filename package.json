{
  "name": "game-webrtc",
  "version": "1.0.0",
  "scripts": {
    "start":       "concurrently \"node local/agent.js\" \"node local/stream-agent.js\"",
    "agent":       "node local/agent.js",
    "stream":      "node local/stream-agent.js",
    "server":      "node public/server-ws/signaling-server.js",
    "web":         "serve public/server-gamepad -l tcp://0.0.0.0:3000",
    "web:stream":  "serve public/server-stream -l tcp://0.0.0.0:3001",
    "dev":         "concurrently \"node public/server-ws/signaling-server.js\" \"node local/agent.js\" \"node local/stream-agent.js\" \"serve public/server-gamepad -l tcp://0.0.0.0:3000\" \"serve public/server-stream -l tcp://0.0.0.0:3001\""
  },
  "dependencies": {
    "ws": "^8.17.0",
    "@nut-tree-fork/nut-js": "^4.2.1",
    "node-datachannel": "^0.10.0",
    "concurrently": "^8.2.0"
  }
}
